# Copie ce fichier en ".env" à la racine et renseigne tes propres valeurs
# avant de lancer : docker-compose -f docker-compose.global.yml up -d --build

# Clé API Google Gemini (utilisée par le Service_ATS pour le scoring intelligent des CVs)
# À obtenir sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Secret utilisé pour signer/valider les JWT (partagé entre AuthService, Service_ATS, my_project)
JWT_SECRET=change_this_secret_in_production
